# Wajib untuk login Google (Google Cloud Console > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Opsional (ada nilai bawaan). Acak panjang, contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Apikey dev/owner (unlimited). Ganti di sini, jangan hardcode di repo publik
DEV_API_KEY=WanzzGantengBanget3369

# Akun dev dengan username "wanz": login di /dashboard (kolom email isi: wanz) + password ini.
# Opsional: sudah ada nilai bawaan di core/auth.js (repo private). Isi di sini untuk menimpa.
DEV_USERNAME=wanz
DEV_PASSWORD=

# Email Google yang juga jadi akun dev (unlimited) saat login pakai Google. Pisahkan koma
DEV_EMAILS=emailkamu@gmail.com

# Batas free per hari (default 500)
DAILY_LIMIT=500

# Wajib di Vercel (filesystem-nya tidak permanen). Gratis di upstash.com, atau pakai Vercel KV
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Di Pterodactyl tanpa Upstash, data akun disimpan di data/db.json

# ---------- OTP verifikasi email (daftar manual) ----------
# true = wajib verifikasi kode 6 digit lewat email. false = matikan OTP.
OTP_ENABLED=true
# Alamat pengirim. WAJIB sama dengan sender yang sudah diverifikasi di penyedia email
MAIL_FROM=emailkamu@gmail.com
MAIL_FROM_NAME=Wanz Api

# PILIH SATU: A) Brevo API (disarankan untuk Vercel)
BREVO_API_KEY=

# atau B) SMTP (contoh Gmail: host smtp.gmail.com, port 465, pass = App Password 16 huruf)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---------- Fitur AI (kategori AI sedang dikunci di settings.js) ----------
# 34 dari 42 endpoint AI memakai Pollinations. Ambil key di https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=

# Key provider AI (opsional, dipakai berurutan dengan cadangan otomatis). Lihat plugin/lib/llm.js
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
